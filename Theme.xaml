<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <SolidColorBrush x:Key="Text" Color="#EDF4FC"/>
  <SolidColorBrush x:Key="Muted" Color="#A0B0C6"/>
  <SolidColorBrush x:Key="Surface" Color="#151E2E"/>
  <SolidColorBrush x:Key="Line" Color="#29354A"/>
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="Background" Value="#1B304B"/>
    <Setter Property="BorderBrush" Value="#314863"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="16,11"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value><ControlTemplate TargetType="Button">
        <Grid Background="Transparent">
          <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
            <Grid>
              <Border x:Name="Glow" Background="#C7FAFF" Opacity="0" CornerRadius="8" IsHitTestVisible="False"/>
              <Border x:Name="PressLight" Opacity="0" CornerRadius="8" IsHitTestVisible="False">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#D5F9FF" Offset="0"/>
                    <GradientStop Color="#52E5BF" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Grid>
          </Border>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Glow" Property="Opacity" Value="0.12"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Glow" Property="Opacity" Value="0.24"/></Trigger>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsMouseOver" Value="True"/>
              <Condition Property="Tag"><Condition.Value><sys:Boolean>True</sys:Boolean></Condition.Value></Condition>
            </MultiTrigger.Conditions>
            <MultiTrigger.EnterActions>
              <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" From="0" To="0.12" Duration="0:0:0.14" FillBehavior="Stop"/></Storyboard></BeginStoryboard>
            </MultiTrigger.EnterActions>
            <MultiTrigger.ExitActions>
              <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" From="0.12" To="0" Duration="0:0:0.16" FillBehavior="Stop"/></Storyboard></BeginStoryboard>
            </MultiTrigger.ExitActions>
          </MultiTrigger>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsPressed" Value="True"/>
              <Condition Property="Tag"><Condition.Value><sys:Boolean>True</sys:Boolean></Condition.Value></Condition>
            </MultiTrigger.Conditions>
            <MultiTrigger.EnterActions>
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.97" Duration="0:0:0.08"/>
                  <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.97" Duration="0:0:0.08"/>
                  <DoubleAnimation Storyboard.TargetName="PressLight" Storyboard.TargetProperty="Opacity" To="0.32" Duration="0:0:0.08"/>
                </Storyboard>
              </BeginStoryboard>
            </MultiTrigger.EnterActions>
            <MultiTrigger.ExitActions>
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.16"/>
                  <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.16"/>
                  <DoubleAnimation Storyboard.TargetName="PressLight" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                </Storyboard>
              </BeginStoryboard>
            </MultiTrigger.ExitActions>
          </MultiTrigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#DAF9FF"/><Setter TargetName="Shell" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="AnimatedButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Tag" Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"/>
  </Style>
  <Style x:Key="StatusBadge" TargetType="ContentControl">
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Padding" Value="9,5"/>
    <Setter Property="Tag" Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <ControlTemplate.Resources>
            <Storyboard x:Key="BadgeSweep" RepeatBehavior="Forever">
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BadgeShimmer" Storyboard.TargetProperty="(Border.Background).(Brush.RelativeTransform).(TranslateTransform.X)">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-0.8"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="0.8"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:4.4" Value="0.8"/>
              </DoubleAnimationUsingKeyFrames>
            </Storyboard>
          </ControlTemplate.Resources>
          <Grid>
            <Border x:Name="BadgeSurface" Background="#1A2A3D" CornerRadius="6"/>
            <Border x:Name="BadgeShimmer" CornerRadius="6" Visibility="Collapsed" IsHitTestVisible="False">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                  <LinearGradientBrush.RelativeTransform><TranslateTransform X="-0.8"/></LinearGradientBrush.RelativeTransform>
                  <GradientStop Color="#005CE3EF" Offset="0.18"/>
                  <GradientStop Color="#526CE8F7" Offset="0.50"/>
                  <GradientStop Color="#005CE3EF" Offset="0.82"/>
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Margin="{TemplateBinding Padding}" TextTrimming="CharacterEllipsis"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Content" Value="Есть обновление">
              <Setter TargetName="BadgeSurface" Property="Background" Value="#123749"/>
            </Trigger>
            <Trigger Property="Content" Value="Без обновлений">
              <Setter TargetName="BadgeSurface" Property="Background" Value="#253143"/>
              <Setter TargetName="BadgeShimmer" Property="Background">
                <Setter.Value>
                  <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <LinearGradientBrush.RelativeTransform><TranslateTransform X="-0.8"/></LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#00D5E5FA" Offset="0.18"/>
                    <GradientStop Color="#46D5E5FA" Offset="0.50"/>
                    <GradientStop Color="#00D5E5FA" Offset="0.82"/>
                  </LinearGradientBrush>
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="Content" Value="Установлено">
              <Setter TargetName="BadgeSurface" Property="Background" Value="#163D34"/>
              <Setter TargetName="BadgeShimmer" Property="Background">
                <Setter.Value>
                  <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <LinearGradientBrush.RelativeTransform><TranslateTransform X="-0.8"/></LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#007FFFC3" Offset="0.18"/>
                    <GradientStop Color="#627FFFC3" Offset="0.50"/>
                    <GradientStop Color="#007FFFC3" Offset="0.82"/>
                  </LinearGradientBrush>
                </Setter.Value>
              </Setter>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Content" Value="Есть обновление"/>
                <Condition Property="Tag"><Condition.Value><sys:Boolean>True</sys:Boolean></Condition.Value></Condition>
                <Condition Property="IsVisible" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="BadgeShimmer" Property="Visibility" Value="Visible"/>
              <MultiTrigger.EnterActions><BeginStoryboard x:Name="AvailableSweep" Storyboard="{StaticResource BadgeSweep}"/></MultiTrigger.EnterActions>
              <MultiTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="AvailableSweep"/></MultiTrigger.ExitActions>
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Content" Value="Установлено"/>
                <Condition Property="Tag"><Condition.Value><sys:Boolean>True</sys:Boolean></Condition.Value></Condition>
                <Condition Property="IsVisible" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="BadgeShimmer" Property="Visibility" Value="Visible"/>
              <MultiTrigger.EnterActions><BeginStoryboard x:Name="InstalledSweep" Storyboard="{StaticResource BadgeSweep}"/></MultiTrigger.EnterActions>
              <MultiTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="InstalledSweep"/></MultiTrigger.ExitActions>
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Content" Value="Без обновлений"/>
                <Condition Property="Tag"><Condition.Value><sys:Boolean>True</sys:Boolean></Condition.Value></Condition>
                <Condition Property="IsVisible" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="BadgeShimmer" Property="Visibility" Value="Visible"/>
              <MultiTrigger.EnterActions><BeginStoryboard x:Name="CurrentSweep" Storyboard="{StaticResource BadgeSweep}"/></MultiTrigger.EnterActions>
              <MultiTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="CurrentSweep"/></MultiTrigger.ExitActions>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="MetricShimmer" TargetType="Border">
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="CornerRadius" Value="11"/>
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="Tag" Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"/>
    <Style.Triggers>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="Tag"><Condition.Value><sys:Boolean>True</sys:Boolean></Condition.Value></Condition>
          <Condition Property="IsVisible" Value="True"/>
        </MultiTrigger.Conditions>
        <Setter Property="Opacity" Value="1"/>
        <MultiTrigger.EnterActions>
          <BeginStoryboard x:Name="MetricSweep">
            <Storyboard RepeatBehavior="Forever">
              <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(Border.Background).(Brush.RelativeTransform).(TranslateTransform.X)">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-0.75"/>
                <LinearDoubleKeyFrame KeyTime="0:0:2.3" Value="0.75"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:6" Value="0.75"/>
              </DoubleAnimationUsingKeyFrames>
            </Storyboard>
          </BeginStoryboard>
        </MultiTrigger.EnterActions>
        <MultiTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="MetricSweep"/></MultiTrigger.ExitActions>
      </MultiTrigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="Background" Value="#151E2E"/>
    <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CaretBrush" Value="#2CCBF1"/>
    <Setter Property="SelectionBrush" Value="#235B80"/>
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
      <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
      </Border>
      <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#2CCBF1"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <StackPanel Orientation="Horizontal" Background="Transparent">
        <Border x:Name="Box" Width="18" Height="18" Background="#0B1728" BorderBrush="#5C7290" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center">
          <Path x:Name="Mark" Visibility="Collapsed" Data="M 3 8 L 7 12 L 14 4" Stroke="#071624" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Border>
        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </StackPanel>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#24CDF1"/><Setter TargetName="Box" Property="BorderBrush" Value="#24CDF1"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="White"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="#1D293C"/>
    <Setter Property="Foreground" Value="#C1CDE1"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="BorderBrush" Value="#263951"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="DataGridRow">
    <Setter Property="Background" Value="{StaticResource Surface}"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1B2B40"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#204154"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="DataGridCell">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell">
      <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10"/>
    <Setter Property="Background" Value="{StaticResource Surface}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
      <Grid Background="{TemplateBinding Background}">
        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
          <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#405773" CornerRadius="4" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        </Track>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/></Trigger></Style.Triggers>
  </Style>
</ResourceDictionary>
